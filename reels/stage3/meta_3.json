   "text": "Chalmersning tajribasi:"
  },
  {
   "f0": 47,
   "fClear": 119,
   "text": "sening aynan nusxangni tasavvur qil."
  },
  {
   "f0": 123,
   "fClear": 216,
   "text": "U ham gapiradi, kuladi, ogʻrisa «voy» deydi."
  },
  {
   "f0": 220,
   "fClear": 314,
   "text": "Lekin ichida hech kim yoʻq — chiroq oʻchiq."
  },
  {
   "f0": 318,
   "fClear": 393,
   "text": "Tashqaridan farqini hech kim bilmaydi."
  },
  {
   "f0": 397,
   "fClear": 437,
   "text": "Faqat sen bilasan."
  }
