 "phrases": [
  {
   "f0": 3,
   "fClear": 75,
   "text": "Tasavvur qil: sen mavjud boʻlmasang,"
  },
  {
   "f0": 78,
   "fClear": 103,
   "text": "nima boʻladi?"
  },
  {
   "f0": 106,
   "fClear": 141,
   "text": "Dunyo toʻxtamaydi."
  },
  {
   "f0": 144,
   "fClear": 220,
   "text": "Soat yuraveradi, avtobus oʻtaveradi,"
  },
  {
   "f0": 223,
   "fClear": 275,
   "text": "shahar chiroqlari yonaveradi."
  },
  {
   "f0": 278,
   "fClear": 327,
   "text": "Lekin sening yoʻqligingni"
  },
  {
   "f0": 330,
   "fClear": 361,
   "text": "kim his qiladi?"
  },
  {
   "f0": 364,
   "fClear": 448,
   "text": "Sen emas — his qiladigan sen yoʻqsan."
  }
 ]
